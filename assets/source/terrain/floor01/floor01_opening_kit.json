  "state_groups": {
    "raking_shore": {
      "states": ["intact", "damaged_1", "damaged_2", "broken"],
      "note": "same rect and placement; gameplay swaps the piece per hit"
    },
    "raking_shore_load": {
      "states": ["seated", "settling", "slipped", "falling", "landed"],
      "note": "seated/slipped share a rect; falling is the debris sprite moved by gameplay; landed is placed on the walking line"
    },
    "timber_set": {"states": ["intact", "smashed"]},
    "timber_barricade": {
      "states": ["intact", "smashed"],
      "note": "96x176 lower option; the layouts use the full-height pair"
    },
    "timber_barricade_full": {
      "states": ["intact", "smashed"],
      "note": "96x280 from the cornice (y 32) to the deck's front lip (y 312): crosses the walking lane and covers the full-height barricade blocker"
    },
    "guild_portal": {
      "states": ["closed", "ajar", "open"],
      "note": "ajar is the 1-frame in-between played when a player enters exit_guild; same rect as closed and open"
    }
  },
  "usage_rules": {
    "S3_chase": "C grammar under a lowered ceiling: copper run along the cornice, valve on a drop, maint_hatch at chest height, timber_set_* every 320 px or so (bottom on the floor back line), jump humps as 1-tile platforms. The two ceiling steps use the soffit tiles: soffit_end_l/_b (left step), soffit_end_r/_b (right step), soffit_corner_* at the low cornice, soffit_joint_* at the high cornice next to the face.",
    "S4_widened": "A grammar at full height: alcove_niche on a 1-tile ledge (6 columns), a pooled torch right of the niche, timber_barricade_full_* (96x280, y 32 to the lip) closing the end.",
    "S5_skirmish": "raking shore set: wall_cavity at block - (8, 8), loose_block_* at the shore head, shore_post_* foot on the deck, hazard_grit centred on the fall region; keep a pier or wall torch within 120 px so the set reads lit. Presentation frames: shore_dust_trickle under the block's split from damaged_1, timber_splinter_burst at each hit, block_impact_dust on the landing.",
    "S6_guild": "guild_portal_* bottom on the floor back line, guild_sign right of the portal at y 168, nothing breakable within 160 px of the portal."
  }
}
